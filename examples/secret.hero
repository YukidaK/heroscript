// secret: diferente de private, a leitura é liberada apenas para missões específicas.

hero NightOwl {
    String name = "Night Owl";

    secret String identity = "Daniel Dreiberg" allow Unmask;
    secret int hideouts = 3 allow Unmask, Patrol;

    mission Unmask {
        announce name + " revela: sou " + identity + " e tenho " + hideouts + " esconderijos";
    }

    mission Patrol {
        announce name + " patrulha " + hideouts + " esconderijos";
        announce "identidade: " + identity;   // Patrol não está autorizada a ler identity
    }
}

battle {
    summon NightOwl as owl;

    owl.Unmask();

    try {
        owl.Patrol();
    } catch (HeroError e) {
        announce e.getMessage();
    }

    announce "Tentando ler de fora: " + owl.identity;   // battle nunca está autorizado
}
