batcave Vault {
    secret final String accessCode = "EXEMPLO";

    secret boolean validate(String code) {
        return accessCode.equals(code);
    }

    public boolean authenticate(String code) {
        return validate(code);
    }
}

hero Analyst {
    secret public int calculate(int input) {
        secret int result = input * 2;
        supervision.getValue(result);
        return result;
    }
}

battle {
    secret int ticket = 12345;
    supervision.getValue(ticket);
    Vault vault = new Vault();
    announce "Autenticado: " + vault.authenticate("EXEMPLO");
    summon Analyst as analyst;
    announce "Resultado: " + analyst.calculate(3);
    int visible = 7;
    supervision.getValue(visible);
}
